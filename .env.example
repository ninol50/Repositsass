# ---------------------------------------------------------------------------
# RepositSaaS — variables d'environnement
# Copie ce fichier en .env.local pour le développement.
# ---------------------------------------------------------------------------

# Obligatoire en production. Génère-la avec :  openssl rand -base64 48
# Sert à signer les cookies de session. 32 caractères minimum.
AUTH_SECRET=

# Base de données Postgres : Supabase, Neon, Vercel Postgres, Railway, local...
# Absente : l'application tourne en mémoire et perd tout à chaque redémarrage.
# Les tables sont créées automatiquement au premier appel.
#
# SUPABASE — prends bien la chaîne « Transaction pooler » (port 6543) :
#   Settings > Database > Connection string > Transaction pooler
#   postgresql://postgres.<ref>:<mdp>@aws-0-<region>.pooler.supabase.com:6543/postgres
# La connexion directe (port 5432) est en IPv6 uniquement : Vercel ne peut pas
# l'atteindre. /api/health te le signale si tu te trompes de chaîne.
DATABASE_URL=

# Ton email (ou plusieurs, séparés par des virgules) pour accéder à /admin et voir
# la liste des inscrits. Non renseigné : la page est inaccessible à tout le monde.
ADMIN_EMAILS=

# URL publique du site, utilisée pour les métadonnées, le sitemap et robots.txt.
NEXT_PUBLIC_SITE_URL=https://repositsaas.vercel.app

# ---------------------------------------------------------------------------
# Whop — paiement
# ---------------------------------------------------------------------------

# Identifiants de plan Whop. Les plans en production sont déjà câblés dans
# src/lib/whop.ts (ce ne sont pas des secrets : ils sont dans l'URL de checkout
# publique). Ne renseigne ces variables que pour les remplacer, par exemple pour
# tester avec des plans bac à sable.
WHOP_PLAN_BASIC_ID=
WHOP_PLAN_PRO_ID=
WHOP_PLAN_MAX_ID=

# Ou colle des URL de checkout complètes, prioritaires sur les ID.
WHOP_PLAN_BASIC_URL=
WHOP_PLAN_PRO_URL=
WHOP_PLAN_MAX_URL=

# Secret du webhook, depuis le dashboard Whop.
# Absent : tous les webhooks sont rejetés et aucun accès n'est accordé.
WHOP_WEBHOOK_SECRET=

# Clé API Whop. Elle alimente les DEUX filets de sécurité :
#   - le bouton « J'ai déjà payé » (/api/billing/recover)
#   - la réconciliation quotidienne (/api/cron/reconcile-billing)
# Absente, il ne reste que le webhook : s'il se perd, le client a payé et reste
# bloqué sans que personne le sache. Dashboard Whop > Developer > API keys.
WHOP_API_KEY=

# Secret du cron Vercel. Vercel l'envoie en `Authorization: Bearer <valeur>` sur
# les tâches planifiées de vercel.json. Absent, la réconciliation refuse de
# s'exécuter — une route qui écrit des plans ne reste pas ouverte.
#   openssl rand -hex 32
CRON_SECRET=

# Base de l'API Whop. À laisser vide en production : sert uniquement à pointer
# les tests vers un bouchon local.
WHOP_API_URL=
